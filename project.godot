; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Hiep Si Ve Vuon"
config/description="Game nong trai + phieu luu + chien dau. Godot 4 / C#."
run/main_scene="res://scenes/LoginScreen.tscn"
config/features=PackedStringArray("4.3", "C#", "Forward Plus")
config/icon="res://icon.svg"

[audio]

driver/enable_input=true

[autoload]

GameManager="*res://scripts/core/GameManager.cs"
ItemDatabase="*res://scripts/systems/ItemDatabase.cs"
IconRenderer="*res://scripts/systems/IconRenderer.cs"
Inventory="*res://scripts/systems/Inventory.cs"
Backpack="*res://scripts/systems/Backpack.cs"
QuestSystem="*res://scripts/systems/QuestSystem.cs"
SaveSystem="*res://scripts/systems/SaveSystem.cs"
MusicPlayer="*res://scripts/systems/MusicPlayer.cs"
FarmStorage="*res://scripts/systems/FarmStorage.cs"
WarehouseDatabase="*res://scripts/systems/WarehouseDatabase.cs"
ContractSystem="*res://scripts/systems/ContractSystem.cs"
BackendClient="*res://scripts/systems/BackendClient.cs"
EconomyClient="*res://scripts/systems/EconomyClient.cs"
NetworkClient="*res://scripts/systems/NetworkClient.cs"
WaterEcosystem="*res://scripts/systems/WaterEcosystem.cs"
SkillSystem="*res://scripts/systems/SkillSystem.cs"
AchievementSystem="*res://scripts/systems/AchievementSystem.cs"
MailSystem="*res://scripts/systems/MailSystem.cs"
FriendshipSystem="*res://scripts/systems/FriendshipSystem.cs"
ShippingSystem="*res://scripts/systems/ShippingSystem.cs"
AdventureSystem="*res://scripts/systems/AdventureSystem.cs"
HomeSystem="*res://scripts/systems/HomeSystem.cs"
FestivalSystem="*res://scripts/systems/FestivalSystem.cs"
WeatherSystem="*res://scripts/systems/WeatherSystem.cs"
PetSystem="*res://scripts/systems/PetSystem.cs"
PlacementSystem="*res://scripts/systems/PlacementSystem.cs"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="HiepSiVeVuon"

