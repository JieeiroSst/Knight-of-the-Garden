# Sao chep file nay thanh ".env" va dien gia tri that truoc khi chay (khong commit ".env" that len git).
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://hsvv:hsvv_password@localhost:5432/hsvv
# PHAI it nhat 16 ky tu - vd tao bang `openssl rand -hex 32`.
JWT_SECRET=doi-chuoi-nay-thanh-1-chuoi-bi-mat-dai-ngau-nhien-that
JWT_EXPIRES_IN=30d
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONN_TIMEOUT_MS=5000
RATE_LIMIT_GENERAL=600
RATE_LIMIT_AUTH=20

# ==== Game online ====
# api | gateway | all (all = ca 2 trong 1 process, khong can Redis - chi dung khi dev/1 may)
ROLE=all
# Bat buoc khi chay NHIEU gateway: REDIS_URL=redis://localhost:6379
REDIS_URL=
GAME_EPOCH=2026-01-01
GAME_TZ_OFFSET_MIN=420
CHANNEL_CAPACITY=80
WS_TICK_MS=200
WS_MAX_CONNECTIONS=50000
MARKET_TAX_PERCENT=5
MARKET_LISTING_DAYS=7
