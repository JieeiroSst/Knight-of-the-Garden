# Sao chep file nay thanh ".env" va dien gia tri that truoc khi chay (khong commit ".env" that len git).
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://hsvv:hsvv_password@localhost:5432/hsvv
# PHAI it nhat 16 ky tu (config/env.js tu kiem tra, dung khoi dong neu ngan hon) - vd tao bang
# `openssl rand -hex 32`.
JWT_SECRET=doi-chuoi-nay-thanh-1-chuoi-bi-mat-dai-ngau-nhien-that
JWT_EXPIRES_IN=30d

# Cac bien lien quan quy mo/tai (xem README "Lo trinh mo rong quy mo that su") - gia tri mac
# dinh phu hop 1 instance duy nhat (docker compose cuc bo). Khi chay NHIEU instance sau load
# balancer, PG_POOL_MAX*so_instance KHONG duoc vuot qua gioi han ket noi cua Postgres (mac dinh
# ~100) - vd 10 instance thi dat PG_POOL_MAX=10 (100 ket noi), hoac dung PgBouncer.
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONN_TIMEOUT_MS=5000
RATE_LIMIT_GENERAL=120
RATE_LIMIT_AUTH=20
